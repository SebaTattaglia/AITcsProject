# ---------------------------------------------------------------------------
# LLM webhook (n8n exposed through ngrok) - same approach as services/kb_generator.py
# in the Incident2KB reference project. No API key: the n8n workflow owns the model.
# The backend POSTs {"system": "...", "prompt": "..."} and accepts plain text or
# JSON {"output" | "article" | "text" | "result"}.
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://nonproscriptively-intimiste-eugenia.ngrok-free.dev/webhook/dev-knowledge
N8N_WEBHOOK_TIMEOUT=120

# ---------------------------------------------------------------------------
# RAG / LangGraph (retrieval uses local TF-IDF vectors)
# ---------------------------------------------------------------------------
DOCS_DIR=data/docs
INDEX_DIR=data/index
CHUNK_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
TOP_K=4
SIMILARITY_THRESHOLD=0.25
MIN_KEYWORD_OVERLAP=1
MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Hybrid mode: when the docs do not answer, reply from general knowledge (labelled)
# and file a draft for admin review. false = strict "I don't know" (assessment spec).
# Approved drafts are published to data/docs/approved/.
# ---------------------------------------------------------------------------
HYBRID_MODE=false
DRAFTS_DIR=data/drafts

# ---------------------------------------------------------------------------
# API authentication: comma-separated "key:role" pairs (roles: developer, admin)
# ---------------------------------------------------------------------------
API_KEYS=dev-key-change-me:developer,admin-key-change-me:admin
